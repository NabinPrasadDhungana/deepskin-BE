# ── Django ──
DEEPSKIN_SECRET_KEY=change-me
DEEPSKIN_DEBUG=True
DEEPSKIN_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (React/dev frontend origins)
DEEPSKIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Postgres (production). Unset DEEPSKIN_DB_ENGINE to use SQLite locally.
DEEPSKIN_DB_ENGINE=postgres
DEEPSKIN_DB_NAME=deepskin
DEEPSKIN_DB_USER=deepskin
DEEPSKIN_DB_PASSWORD=
DEEPSKIN_DB_HOST=localhost
DEEPSKIN_DB_PORT=5432

# Redis (broker for Celery tasks + SSE pub/sub)
DEEPSKIN_REDIS_URL=redis://localhost:6379/0

# ML model + classification
DEEPSKIN_MODEL_PATH=mlservice/model/final_model_cbam.keras
DEEPSKIN_CLASSIFICATION_THRESHOLD=0.30

# Hosted inference (Hugging Face Spaces). The heavy TF model runs on HF,
# NOT in the Django container. Set DEEPSKIN_HF_URL to your Space's endpoint
# (https://<owner>-<space>.hf.space) and DEEPSKIN_HF_TOKEN to the same
# shared-secret you set as a Space secret. DEEPSKIN_HF_CALLBACK_URL is where
# HF posts results (local Django by default; https URL after deploy).
DEEPSKIN_HF_URL=http://localhost:7860
DEEPSKIN_HF_TOKEN=
DEEPSKIN_HF_CALLBACK_URL=http://localhost:8000/api/ml/result/

# Production DB via a single connection string (e.g. Render Postgres injects
# DATABASE_URL). When set, it overrides the DEEPSKIN_DB_* vars above; unset to
# use those.
#DATABASE_URL=postgres://user:pass@host:5432/deepskin

# Backblaze B2 media storage (S3-compatible). Set BACKBLAZE_KEY_ID to route
# media uploads to B2; leave unset to use the local filesystem (dev/tests).
# Create an Application Key (Read & Write) scoped to your bucket, and use
# the region string from the bucket details page (e.g. us-west-004).
BACKBLAZE_KEY_ID=5rv6bnytf6789ghbn678h
BACKBLAZE_APPLICATION_KEY=K228DSKJH7222KKK92I887UD
BACKBLAZE_BUCKET_NAME=my-bucket
BACKBLAZE_REGION=us-east-003

# Trust SSL from the cloud reverse proxy so DRF emits https media URLs
DEEPSKIN_TRUST_PROXY_SSL=True